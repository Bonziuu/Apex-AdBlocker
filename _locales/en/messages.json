  "about_intro": {
    "message": "Apex AdBlocker runs on Manifest V3 (MV3) and blocks on three levels:"
  },
  "about_network": {
    "message": "<b>Network</b> – requests for ads and tracking scripts are blocked with declarativeNetRequest rules."
  },
  "about_cosmetic": {
    "message": "<b>Element hiding</b> – empty frames and leftover ad containers are hidden cosmetically (style sheets)."
  },
  "about_scriptlets": {
    "message": "<b>Scriptlets</b> – on sites that detect blockers or weave ads into the player, Apex AdBlocker runs only supported scriptlet variants and skips the rest."
  },
  "about_limitsTitle": {
    "message": "Limitations"
  },
  "about_limits": {
    "message": "Apex AdBlocker supports a subset of the uBO/ABP filter syntax. Some filters can’t be expressed in MV3 (e.g. HTML filtering, CSP headers, blocking pop-ups over the network) and some scriptlets aren’t implemented, so on some sites blocking may be less effective than in uBlock Origin. Apex AdBlocker doesn’t promise to be undetectable by sites."
  },
  "about_listsTitle": {
    "message": "Filter lists"
  },
  "about_lists": {
    "message": "EasyList, EasyPrivacy (© The EasyList authors, GPLv3 / CC BY-SA 3.0), uBlock filters (© Raymond Hill and contributors, GPLv3), Polish Ad Filters (© MajkiIT, CC BY-NC-SA 4.0). The lists are built into the extension – to refresh them, see the README file."
  },
