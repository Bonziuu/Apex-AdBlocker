{
  "name": "apex-adblocker",
  "private": true,
  "description": "Apex AdBlocker – lekki bloker reklam dla Chrome (Manifest V3). Narzędzia deweloperskie: build reguł, audyt scriptletów, testy.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "audit:scriptlets": "node tools/audit-scriptlets.mjs",
    "build": "node tools/build.mjs",
    "update-lists": "node tools/update-lists.mjs",
    "check": "node tools/check.mjs",
    "perf:baseline": "node tools/perf-baseline.mjs",
    "test:e2e": "node tools/run-tests.mjs --e2e",
    "package:dev": "node tools/package-dev.mjs",
    "package:release": "node tools/package-release.mjs",
    "package:store": "node tools/package-store.mjs",
    "icons": "node tools/build-icons.mjs",
    "test:local": "node tests/local/apex-local-test.mjs",
    "test:sites": "node tests/local/single-blocker-sites.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
