{
  "name": "chromeblock",
  "version": "0.2.0",
  "private": true,
  "description": "ChromeBlock – bloker reklam dla Chrome (Manifest V3). Narzędzia deweloperskie: build reguł, audyt scriptletów, testy.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "audit:scriptlets": "node tools/audit-scriptlets.mjs",
    "build": "node tools/build.mjs",
    "update-lists": "node tools/update-lists.mjs",
    "check": "node tools/check.mjs",
    "test:e2e": "node --test \"tests/e2e/*.e2e.mjs\""
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
