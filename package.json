{
  "name": "chromeblock",
  "version": "0.3.4",
  "private": true,
  "description": "ChromeBlock – bloker reklam dla Chrome (Manifest V3). Narzędzia deweloperskie: build reguł, audyt scriptletów, testy.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "audit:scriptlets": "node tools/audit-scriptlets.mjs",
    "build": "node tools/build.mjs",
    "update-lists": "node tools/update-lists.mjs",
    "check": "node tools/check.mjs",
    "perf:baseline": "node tools/perf-baseline.mjs",
    "test:e2e": "node tools/run-tests.mjs --e2e",
    "package:dev": "node tools/package-dev.mjs",
    "test:local": "node tests/local/chromeblock-local-test.mjs",
    "test:sites": "node tests/local/single-blocker-sites.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
